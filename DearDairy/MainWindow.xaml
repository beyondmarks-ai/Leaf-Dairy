        </Grid>

        <!-- Root-level decoration keeps the feather above the sidebar and timeline content. -->
        <Image Grid.Column="0" Panel.ZIndex="50" Source="Assets/side-feather.png" Width="150" Height="300" Stretch="Uniform" Opacity="0.96" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-75,-12" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="28"/></Image.RenderTransform></Image>

        <Grid x:Name="NewEntryOverlay" Grid.ColumnSpan="3" Panel.ZIndex="100" Visibility="Collapsed" Background="#F205070A">
            <local:NewEntryWindow x:Name="NewEntryComposer" CloseRequested="NewEntryComposer_CloseRequested"/>
        </Grid>
    </Grid>
</Window>
