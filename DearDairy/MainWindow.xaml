            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,5,0,10" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Timeline Overview" FontSize="16" FontWeight="SemiBold"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Width="112" Height="112"><Ellipse Stroke="#6F45D2" StrokeThickness="22"/><Ellipse Stroke="#4673D5" StrokeThickness="22" Margin="18"/><Ellipse Fill="#111929" Margin="35"/><TextBlock Text="40%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AEB7C9"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="●  Plot Development     40%" Foreground="#C7CEDC" Margin="0,5"/><TextBlock Text="●  World Building       30%" Foreground="#8EA8E8" Margin="0,5"/><TextBlock Text="●  Character Dev.       20%" Foreground="#75CBA3" Margin="0,5"/><TextBlock Text="●  Personal Notes       10%" Foreground="#E5B34F" Margin="0,5"/></StackPanel></Grid></Grid></Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,5,0,10" Padding="16"><StackPanel><TextBlock Text="Today's Themes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><WrapPanel><Border Style="{StaticResource Tag}"><TextBlock Text="# adventure"/></Border><Border Style="{StaticResource Tag}"><TextBlock Text="# magic"/></Border><Border Style="{StaticResource Tag}"><TextBlock Text="# mystery"/></Border><Border Style="{StaticResource Tag}"><TextBlock Text="# kingdom"/></Border><Border Style="{StaticResource Tag}"><TextBlock Text="# prophecy"/></Border></WrapPanel><Button Style="{StaticResource GhostButton}" Content="＋ Add Theme" HorizontalAlignment="Left" Padding="12,7"/></StackPanel></Border>
